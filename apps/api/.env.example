APP_ENV=development
PORT=8080

# MongoDB Atlas — Replace with your Atlas URI
MONGODB_URI=mongodb+srv://REPLACE_ME@cluster.mongodb.net/dineflow?retryWrites=true&w=majority
MONGODB_DATABASE=dineflow

# Upstash Redis — Replace with your Upstash URL
REDIS_URL=rediss://REPLACE_ME@REPLACE_ME.upstash.io:6380

# JWT — Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=dev-access-secret-minimum-64-characters-required-please-change-this-in-production-abc123
JWT_REFRESH_SECRET=dev-refresh-secret-minimum-64-characters-required-please-change-this-in-production-xyz456
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Resend (Email) — Get from resend.com
RESEND_API_KEY=re_REPLACE_ME
EMAIL_FROM=noreply@dineflow.app
EMAIL_FROM_NAME=DineFlow

# Cloudflare R2 (File Storage) — Optional for Phase 1
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=dineflow-assets
R2_PUBLIC_URL=

# WhatsApp — Optional for Phase 1
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=dineflow-webhook-verify
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Super Admin — Keep private
SUPER_ADMIN_SECRET=dev-super-admin-secret-change-in-production
