# =============================================================================
# DineFlow — Environment Variables Example
# Copy this file to .env.local (frontend) and apps/api/.env (backend)
# =============================================================================

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_ENV=development

# ─── API ──────────────────────────────────────────────────────────────────────
# Backend API URL consumed by the Next.js frontend
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# ─── Database — MongoDB Atlas ─────────────────────────────────────────────────
# Get from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dineflow?retryWrites=true&w=majority

# ─── Cache — Upstash Redis ───────────────────────────────────────────────────
# Get from: https://console.upstash.com → Create Database → REST API
REDIS_URL=rediss://<user>:<password>@<host>:<port>

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=your-super-secret-access-token-key-min-64-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-min-64-chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ─── Email — Resend ──────────────────────────────────────────────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@dineflow.app
EMAIL_FROM_NAME=DineFlow

# ─── File Storage — Cloudflare R2 ────────────────────────────────────────────
# Get from: Cloudflare Dashboard → R2 → Manage API tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=dineflow-assets
R2_PUBLIC_URL=https://assets.dineflow.app

# ─── Payments — Razorpay ─────────────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ─── WhatsApp — Meta Cloud API / OpenWA Gateway ──────────────────────────────
# Active provider: "openwa" (local dev) | "meta" (production Cloud API) | "mock" (in-memory sandbox)
WHATSAPP_PROVIDER=openwa
OPENWA_URL=http://localhost:2785
OPENWA_API_KEY=dineflow_openwa_secret_key
OPENWA_SESSION_ID=dineflow-dev
OPENWA_WEBHOOK_SECRET=dineflow_openwa_webhook_secret
WHATSAPP_ADMIN_NUMBERS=+919800012345
WHATSAPP_LARGE_ORDER_THRESHOLD=1500

# Meta Cloud API (Production fallback)
# Get from: https://developers.facebook.com → WhatsApp Business Platform
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-random-verify-token
WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-id

# ─── Frontend Public Variables ────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=DineFlow
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ORDERING_URL=http://localhost:3000/order

# ─── Sentry (Error Tracking) ─────────────────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/xxxxx
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/xxxxx

# ─── AI / Gemini (Phase 6) ────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
# Leave empty to run in mock mode (fully functional UI without API calls)
GEMINI_API_KEY=

# ─── Internal ─────────────────────────────────────────────────────────────────
# Secret for super-admin access — keep this extremely private
SUPER_ADMIN_SECRET=your-super-admin-secret-key
